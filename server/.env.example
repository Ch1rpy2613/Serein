# 和风天气（服务端专用，勿提交真实值；chmod 600 server/.env）
# 专属 API Host + 头认证 X-QW-Api-Key（勿用公共域名与 ?key=）
QWEATHER_HOST=your-api-host.example.com
QWEATHER_KEY=your-api-key

# 监听（可选；默认 127.0.0.1:8787）
# SEREIN_HOST=127.0.0.1
# SEREIN_PORT=8787

# Web Push VAPID（npx web-push generate-vapid-keys）
# 公钥须同步到前端根目录 .env 的 VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 本地验收：=1 时跳过和风，对每个订阅城市注入一条橙色 mock 预警
# ALERT_PUSH_MOCK=1
