# Serein 生产 Caddyfile
# 安装：sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
# 将 serein.example.com 换成你的域名；Caddy 自动申请并续期 HTTPS。

serein.example.com {
	root * /srv/serein/dist
	encode zstd gzip

	# /api/* → Node（127.0.0.1:8787）；其余走静态 dist
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
