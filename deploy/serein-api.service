[Unit]
Description=Atmos API (Hono · SQLite · QWeather / Push / Sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atmos
Group=atmos
WorkingDirectory=/srv/atmos/server
EnvironmentFile=/srv/atmos/server/.env
ExecStart=/usr/bin/tsx /srv/atmos/server/src/index.ts
Restart=always
RestartSec=3
# 仅本机监听；对外由 Caddy 反代
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/atmos/server/data

[Install]
WantedBy=multi-user.target
